{
  "name": "shrty",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter @shrty/api dev\" \"pnpm --filter @shrty/web dev\"",
    "build": "pnpm -r build",
    "test": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
