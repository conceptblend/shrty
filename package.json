{
  "name": "shrty",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter @shrty/api dev\" \"pnpm --filter @shrty/web dev\"",
    "build": "pnpm -r build",
    "test": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "drizzle-kit": "^0.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.0"
  }
}
